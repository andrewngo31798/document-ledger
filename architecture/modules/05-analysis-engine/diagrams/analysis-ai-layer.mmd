flowchart TB
    subgraph inputs [Structured inputs]
        classified[classified_decision]
        ledger[(Decision Ledger)]
        graph[(Knowledge Graph)]
        vector[(Vector DB)]
    end

    subgraph deterministic [Deterministic layer — no generative LLM]
        d_retrieve[Hybrid retrieval<br/>vector + BM25 + graph edges]
        d_diff[Structured field diff<br/>8 dimensions + change classification]
        d_traverse[Graph traversal<br/>2–3 hops blast radius]
        d_risk[Risk dimension scoring<br/>technical, delivery, people]
        d_rules[Governance rule engine<br/>required recommendations]
    end

    subgraph llm [LLM synthesis layer — grounded only]
        gateway[AI Gateway<br/>Model Router → JSON Schema → Grounding Verifier]
        llm_diff[Ledger Diff<br/>headline + summary from changes[]]
        llm_impact[Impact<br/>optional summary from traversal facts]
        llm_rec["Recommendation<br/>enrichment only<br/>evidence_refs required"]
    end

    subgraph output [Output]
        pkg[Insight Package<br/>ledger_diff, impact_map,<br/>recommendations]
        review[Review Portal]
    end

    classified --> d_retrieve
    ledger --> d_retrieve
    vector --> d_retrieve
    graph --> d_retrieve
    d_retrieve --> d_diff
    classified --> d_traverse
    graph --> d_traverse
    d_traverse --> d_risk

    d_diff --> gateway
    d_risk --> gateway
    d_rules --> gateway

    gateway --> llm_diff
    gateway --> llm_impact
    gateway --> llm_rec

    d_diff --> pkg
    d_risk --> pkg
    d_rules --> pkg
    llm_diff --> pkg
    llm_impact --> pkg
    llm_rec --> pkg

    pkg --> review

    note["Discussion precedent + change capture →<br/>Forecast Engine (module 09), not Analysis"]
