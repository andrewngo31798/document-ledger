flowchart LR
    subgraph trigger [Trigger — decision path only]
        evt["decision.classified<br/>+ routing.sub_engines"]
    end

    subgraph profiles [Analysis profiles]
        full["full_analysis<br/>all 3 sub-engines"]
        std["standard_analysis<br/>diff + impact + recommendation"]
        light["lightweight_analysis<br/>diff + recommendation"]
        rf["review_first<br/>skip all sub-engines"]
    end

    subgraph dag [Execution DAG]
        direction TB
        p1a[ledger_diff]
        p1b[impact]
        p2[recommendation]
        agg[insight_aggregator]

        p1a --> p2
        p1b --> p2
        p1a --> agg
        p1b --> agg
        p2 --> agg
    end

    subgraph deps [Dependency rules]
        d1["recommendation requires ledger_diff"]
        d2["impact optional per profile"]
        d3["violation → DLQ + audit error"]
    end

    subgraph outputs [Sub-engine outputs]
        o1["ledger_diff"]
        o2["impact_map"]
        o3["recommendations[]"]
    end

    subgraph note [Forecast Engine]
        n1["Module 09 — discussion path only<br/>NOT part of Analysis DAG"]
    end

    evt --> profiles
    profiles --> dag

    p1a -.-> o1
    p1b -.-> o2
    p2 -.-> o3
    agg --> pkg["insight_package"]
