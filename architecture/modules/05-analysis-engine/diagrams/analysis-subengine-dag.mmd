flowchart LR
    subgraph trigger [Trigger]
        evt["decision.classified<br/>+ routing.sub_engines"]
    end

    subgraph profiles [Analysis profiles]
        full["full_analysis<br/>all 4 sub-engines"]
        std["standard_analysis<br/>skip forecast"]
        light["lightweight_analysis<br/>diff + recommendation"]
        rf["review_first<br/>skip all sub-engines"]
    end

    subgraph dag [Execution DAG]
        direction TB
        p1a[ledger_diff]
        p1b[impact]
        p2[forecast]
        p3[recommendation]
        agg[insight_aggregator]

        p1a --> p2
        p1b --> p2
        p1a --> p3
        p1b --> p3
        p2 --> p3
        p1a --> agg
        p1b --> agg
        p2 --> agg
        p3 --> agg
    end

    subgraph deps [Dependency rules]
        d1["forecast requires impact"]
        d2["recommendation requires ledger_diff"]
        d3["violation → DLQ + audit error"]
    end

    subgraph outputs [Sub-engine outputs]
        o1["ledger_diff<br/>headline, change_classification, changes[]"]
        o2["impact_map<br/>blast_radius_score, affected_systems"]
        o3["forecast_report<br/>predicted_outcomes[], confidence_band"]
        o4["recommendations[]<br/>type, priority, ledger_action"]
    end

    evt --> profiles
    profiles --> dag

    p1a -.-> o1
    p1b -.-> o2
    p2 -.-> o3
    p3 -.-> o4
    agg --> pkg["insight_package"]
