{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-ledger/schemas/insight-package",
  "title": "Insight Package",
  "description": "Aggregated output from Analysis Engine consumed by Review & Approval Portal. Ledger diff is the primary section.",
  "type": "object",
  "required": [
    "insight_package_id",
    "classified_decision_id",
    "tenant_id",
    "analysis_profile",
    "decision_summary",
    "ledger_diff",
    "provenance",
    "quality"
  ],
  "properties": {
    "insight_package_id": { "type": "string", "format": "uuid" },
    "classified_decision_id": { "type": "string", "format": "uuid" },
    "knowledge_id": { "type": "string", "format": "uuid" },
    "decision_candidate_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string" },
    "analysis_profile": {
      "type": "string",
      "enum": ["full_analysis", "standard_analysis", "lightweight_analysis", "review_first"]
    },
    "decision_summary": {
      "type": "object",
      "required": ["text", "domain", "categories"],
      "properties": {
        "text": { "type": "string" },
        "domain": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "start_offset": { "type": "integer" },
            "end_offset": { "type": "integer" },
            "source_url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "ledger_diff": {
      "type": "object",
      "description": "Primary output: what changes compared to the current Decision Ledger.",
      "required": ["headline", "change_classification", "confidence"],
      "properties": {
        "headline": {
          "type": "string",
          "description": "One-line answer for reviewers: what changed vs ledger"
        },
        "summary": {
          "type": "string",
          "description": "Paragraph explaining the delta and why it matters"
        },
        "change_classification": {
          "type": "string",
          "enum": [
            "first_of_kind",
            "extends",
            "amends",
            "supersedes",
            "conflicts",
            "reaffirms",
            "duplicate",
            "no_ledger_match",
            "deferred"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "primary_reference": {
          "type": "object",
          "description": "Closest ledger record used as diff baseline",
          "properties": {
            "ledger_record_id": { "type": "string" },
            "title": { "type": "string" },
            "approved_at": { "type": "string", "format": "date-time" },
            "version": { "type": "integer" }
          }
        },
        "changes": {
          "type": "array",
          "description": "Field-level deltas between candidate and ledger baseline",
          "items": {
            "type": "object",
            "required": ["dimension", "candidate_value", "change_type"],
            "properties": {
              "dimension": {
                "type": "string",
                "enum": ["scope", "technology", "constraint", "policy", "timeline", "ownership", "status", "rationale", "other"]
              },
              "candidate_value": { "type": "string" },
              "ledger_value": { "type": "string" },
              "change_type": {
                "type": "string",
                "enum": ["added", "removed", "modified", "replaced", "unchanged"]
              },
              "evidence_candidate": { "type": "string" },
              "evidence_ledger": { "type": "string" }
            }
          }
        },
        "unchanged_aspects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicitly unchanged dimensions vs primary reference"
        },
        "related_ledger_records": {
          "type": "array",
          "description": "Supporting ledger records from retrieval (precedents, conflicts, duplicates)",
          "items": {
            "type": "object",
            "required": ["ledger_record_id", "title", "relationship"],
            "properties": {
              "ledger_record_id": { "type": "string" },
              "title": { "type": "string" },
              "similarity_score": { "type": "number" },
              "relationship": {
                "type": "string",
                "enum": ["primary_reference", "precedent", "supersedes_target", "conflicts_with", "related", "duplicate_of"]
              },
              "approved_at": { "type": "string", "format": "date-time" },
              "summary": { "type": "string" },
              "evidence_snippet": { "type": "string" }
            }
          }
        }
      }
    },
    "impact_map": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "blast_radius_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "affected_systems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "impact_level"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "impact_level": { "type": "string", "enum": ["direct", "indirect", "transitive"] },
              "hop_distance": { "type": "integer", "minimum": 0 },
              "evidence": { "type": "string" }
            }
          }
        },
        "affected_teams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "impact_type": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "risk_dimensions": {
          "type": "object",
          "description": "Impact risk scores (0–1). compliance and financial deferred — may involve confidential data.",
          "properties": {
            "technical": { "type": "number", "minimum": 0, "maximum": 1 },
            "delivery": { "type": "number", "minimum": 0, "maximum": 1 },
            "people": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "action", "priority"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["governance", "documentation", "review", "implementation", "communication", "rollback_plan", "ledger_action"]
          },
          "action": { "type": "string" },
          "priority": { "type": "string", "enum": ["required", "recommended", "optional"] },
          "rationale": { "type": "string" },
          "owner_hint": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "ledger_action": {
            "type": "string",
            "enum": ["approve_new", "approve_amendment", "approve_supersedes", "resolve_conflict", "reject_duplicate", "no_ledger_change"],
            "description": "Suggested ledger outcome when type is ledger_action"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sub_engines_run", "model_versions", "duration_ms"],
      "properties": {
        "sub_engines_run": {
          "type": "array",
          "items": { "type": "string", "enum": ["ledger_diff", "impact", "recommendation"] }
        },
        "model_versions": { "type": "object" },
        "graph_queries": { "type": "integer" },
        "retrieval_queries": { "type": "integer" },
        "llm_calls": { "type": "integer" },
        "duration_ms": { "type": "integer" }
      }
    },
    "quality": {
      "type": "object",
      "required": ["completeness_score", "grounding_score"],
      "properties": {
        "completeness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "grounding_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "review_priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
