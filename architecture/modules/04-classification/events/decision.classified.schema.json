{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-ledger/events/decision.classified",
  "title": "decision.classified",
  "description": "Event published by Classification Engine when a decision candidate is classified and ready for analysis.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "tenant_id",
    "job_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_type": { "const": "decision.classified" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": [
        "classified_decision_id",
        "knowledge_id",
        "decision_candidate_id",
        "classification",
        "routing"
      ],
      "properties": {
        "classified_decision_id": { "type": "string", "format": "uuid" },
        "knowledge_id": { "type": "string", "format": "uuid" },
        "decision_candidate_id": { "type": "string", "format": "uuid" },
        "classification": {
          "type": "object",
          "required": ["domain", "categories", "confidence", "method"],
          "properties": {
            "domain": {
              "type": "string",
              "enum": ["business", "technical", "hybrid"]
            },
            "categories": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "method": {
              "type": "string",
              "enum": ["rule", "classifier", "llm", "hybrid"]
            },
            "rationale": { "type": "string" },
            "taxonomy_version": { "type": "string" }
          }
        },
        "routing": {
          "type": "object",
          "required": ["analysis_profile"],
          "properties": {
            "analysis_profile": {
              "type": "string",
              "enum": ["full_analysis", "standard_analysis", "lightweight_analysis", "review_first"]
            },
            "sub_engines": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["ledger_diff", "impact", "forecast", "recommendation"]
              }
            },
            "priority": {
              "type": "string",
              "enum": ["low", "normal", "high"]
            }
          }
        },
        "source_context": {
          "type": "object",
          "properties": {
            "source_type": { "type": "string" },
            "source_external_id": { "type": "string" },
            "signal_type": { "type": "string" }
          }
        }
      }
    }
  }
}
